{
    "name": "Checkmk plugin dev (${localWorkspaceFolderBasename})",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            // Per plugin: pick the Checkmk edition and version to develop against.
            // EDITION: cloud | enterprise | raw (image checkmk/check-mk-<EDITION>)
            "EDITION": "cloud",
            "VARIANT": "2.4.0p27",
            "CLAUDE_CODE_VERSION": "latest"
        }
    },
    "init": true,

    // Runs on the host before the container is created: bind mounts fail if
    // their source directory is missing.
    "initializeCommand": "mkdir -p plugins lib bin agents plugins_legacy nagios_plugins temp",

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.flake8",
                "ms-python.isort",
                "ms-python.pylint",
                "ms-python.black-formatter",
                "anthropic.claude-code"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "python.defaultInterpreterPath": "/omd/sites/cmk/bin/python3",
                "python.testing.pytestEnabled": true,
                "python.testing.pytestArgs": ["tests"],
                "[python]": {
                    "editor.defaultFormatter": "ms-python.black-formatter"
                }
            }
        }
    },

    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind",

    "mounts": [
        { "source": "${localWorkspaceFolder}/lib", "target": "/opt/omd/sites/cmk/local/lib/python3/cmk", "type": "bind" },
        { "source": "${localWorkspaceFolder}/plugins", "target": "/opt/omd/sites/cmk/local/lib/python3/cmk_addons/plugins", "type": "bind" },
        { "source": "${localWorkspaceFolder}/plugins_legacy", "target": "/opt/omd/sites/cmk/local/share/check_mk", "type": "bind" },
        { "source": "${localWorkspaceFolder}/bin", "target": "/opt/omd/sites/cmk/local/bin", "type": "bind" },
        { "source": "${localWorkspaceFolder}/agents", "target": "/opt/omd/sites/cmk/local/share/check_mk/agents", "type": "bind" },
        // Claude Code config, login and memory: one named volume shared by all
        // plugin projects (log in once, survives rebuilds, never in the repo).
        { "source": "checkmk-claude-config", "target": "/opt/omd/sites/cmk/.claude", "type": "volume" }
    ],

    "postCreateCommand": "bash .devcontainer/post-create.sh",
    "postStartCommand": "bash -lc 'bash .devcontainer/startup.sh </dev/null >/omd/sites/cmk/var/log/devcontainer-poststart.log 2>&1'",

    "remoteUser": "cmk",
    "userEnvProbe": "loginShell",

    // Checkmk GUI: VS Code forwards it to a free local port (see the Ports
    // view), so several plugin containers can run side by side.
    "forwardPorts": [5000],
    "portsAttributes": {
        "5000": { "label": "Checkmk GUI (/cmk/, cmkadmin/cmkadmin)", "onAutoForward": "notify" }
    },

    // Pylance gets SIGKILLed with less memory on larger code bases.
    "runArgs": [
        "--cpus=2",
        "--memory=8g",
        "--memory-swap=10g"
    ],

    // containerEnv (not remoteEnv) so it also applies to `docker exec` shells
    // and lifecycle scripts.
    "containerEnv": {
        "CLAUDE_CONFIG_DIR": "/opt/omd/sites/cmk/.claude"
    },
    "remoteEnv": {
        "PATH": "/omd/sites/cmk/bin:/omd/sites/cmk/local/lib/python3/bin:${containerEnv:PATH}",
        "OMD_ROOT": "/omd/sites/cmk",
        "OMD_SITE": "cmk",
        "CMK_SITE_ID": "cmk",
        "WORKSPACE": "${containerWorkspaceFolder}",
        "NODE_OPTIONS": "--max-old-space-size=4096"
    }
}
